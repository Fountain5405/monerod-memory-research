From 1c15cefd656e3e3d0183b42911cbe27c9e25fe77 Mon Sep 17 00:00:00 2001
From: optimizer <optimizer@hydrogen>
Date: Tue, 3 Nov 2026 00:17:02 +0000
Subject: [PATCH 4/5] E007: build fcmp_pp_rust against local monero-oxide-e007
 (streaming verify)

Patch the monero-oxide crates changed by E007 (generalized-bulletproofs,
generalized-bulletproofs-circuit-abstraction, full-chain-membership-proofs)
to ~/work/monero-oxide-e007, along with the path dependencies of
full-chain-membership-proofs which must resolve to the same packages
(generalized-bulletproofs-ec-gadgets, ec-divisors).

Cargo.lock only drops the git `source` lines of the patched crates (and
moves to lockfile format version 4).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/fcmp_pp/fcmp_pp_rust/Cargo.lock | 7 +------
 src/fcmp_pp/fcmp_pp_rust/Cargo.toml | 8 ++++++++
 2 files changed, 9 insertions(+), 6 deletions(-)

diff --git a/src/fcmp_pp/fcmp_pp_rust/Cargo.lock b/src/fcmp_pp/fcmp_pp_rust/Cargo.lock
index cfdb3b838..3375d6f3f 100644
--- a/src/fcmp_pp/fcmp_pp_rust/Cargo.lock
+++ b/src/fcmp_pp/fcmp_pp_rust/Cargo.lock
@@ -1,6 +1,6 @@
 # This file is automatically @generated by Cargo.
 # It is not intended for manual editing.
-version = 3
+version = 4
 
 [[package]]
 name = "base16ct"
@@ -206,7 +206,6 @@ dependencies = [
 [[package]]
 name = "ec-divisors"
 version = "0.1.0"
-source = "git+https://github.com/monero-oxide/monero-oxide?rev=31c26d96eaadbba910ffe3613ad8b4cf9c598a93#31c26d96eaadbba910ffe3613ad8b4cf9c598a93"
 dependencies = [
  "crypto-bigint",
  "dalek-ff-group 0.5.0",
@@ -310,7 +309,6 @@ checksum = "77ce24cb58228fbb8aa041425bb1050850ac19177686ea6e0f41a70416f56fdb"
 [[package]]
 name = "full-chain-membership-proofs"
 version = "0.1.0"
-source = "git+https://github.com/monero-oxide/monero-oxide?rev=31c26d96eaadbba910ffe3613ad8b4cf9c598a93#31c26d96eaadbba910ffe3613ad8b4cf9c598a93"
 dependencies = [
  "blake2",
  "ciphersuite",
@@ -336,7 +334,6 @@ checksum = "e6d5a32815ae3f33302d95fdcb2ce17862f8c65363dcfd29360480ba1001fc9c"
 [[package]]
 name = "generalized-bulletproofs"
 version = "0.1.0"
-source = "git+https://github.com/monero-oxide/monero-oxide?rev=31c26d96eaadbba910ffe3613ad8b4cf9c598a93#31c26d96eaadbba910ffe3613ad8b4cf9c598a93"
 dependencies = [
  "blake2",
  "ciphersuite",
@@ -353,7 +350,6 @@ dependencies = [
 [[package]]
 name = "generalized-bulletproofs-circuit-abstraction"
 version = "0.1.0"
-source = "git+https://github.com/monero-oxide/monero-oxide?rev=31c26d96eaadbba910ffe3613ad8b4cf9c598a93#31c26d96eaadbba910ffe3613ad8b4cf9c598a93"
 dependencies = [
  "ciphersuite",
  "generalized-bulletproofs",
@@ -364,7 +360,6 @@ dependencies = [
 [[package]]
 name = "generalized-bulletproofs-ec-gadgets"
 version = "0.1.0"
-source = "git+https://github.com/monero-oxide/monero-oxide?rev=31c26d96eaadbba910ffe3613ad8b4cf9c598a93#31c26d96eaadbba910ffe3613ad8b4cf9c598a93"
 dependencies = [
  "ciphersuite",
  "generalized-bulletproofs-circuit-abstraction",
diff --git a/src/fcmp_pp/fcmp_pp_rust/Cargo.toml b/src/fcmp_pp/fcmp_pp_rust/Cargo.toml
index 70f7a9878..791116acd 100644
--- a/src/fcmp_pp/fcmp_pp_rust/Cargo.toml
+++ b/src/fcmp_pp/fcmp_pp_rust/Cargo.toml
@@ -59,3 +59,11 @@ generalized-bulletproofs-ec-gadgets = { opt-level = 3 }
 full-chain-membership-proofs = { opt-level = 3 }
 
 monero-fcmp-plus-plus = { opt-level = 3 }
+
+[patch."https://github.com/monero-oxide/monero-oxide"]
+generalized-bulletproofs = { path = "/home/optimizer/work/monero-oxide-e007/crypto/generalized-bulletproofs" }
+generalized-bulletproofs-circuit-abstraction = { path = "/home/optimizer/work/monero-oxide-e007/crypto/fcmps/circuit-abstraction" }
+full-chain-membership-proofs = { path = "/home/optimizer/work/monero-oxide-e007/crypto/fcmps" }
+# Path dependencies of the above, which must resolve to the same packages as the other crates use
+generalized-bulletproofs-ec-gadgets = { path = "/home/optimizer/work/monero-oxide-e007/crypto/fcmps/ec-gadgets" }
+ec-divisors = { path = "/home/optimizer/work/monero-oxide-e007/crypto/divisors" }
