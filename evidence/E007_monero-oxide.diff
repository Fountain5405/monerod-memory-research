+#[test]
+fn test_split_verify_matches_legacy_verify() {
+  for _ in 0 .. 50 {
+    let instance = Instance::random();
+    let rng = DeterministicRng::new();
+
+    let (legacy_res, legacy_verifier) =
+      instance.verify_with(&rng, &instance.proof, |rng, verifier, transcript| {
+        instance.statement().legacy_verify(rng, verifier, transcript)
+      });
+    let (res, verifier) = instance.verify_with(&rng, &instance.proof, |rng, verifier, transcript| {
+      instance.statement().verify(rng, verifier, transcript)
+    });
+    let (folded_res, folded_verifier) =
+      instance.verify_with(&rng, &instance.proof, |rng, verifier, transcript| {
+        let pending = instance.folded_statement().verify_transcript(rng, verifier, transcript)?;
+        let mut accumulator = pending.accumulator().unwrap();
+        for constraint in instance.constraints.clone() {
+          accumulator.push(constraint).unwrap();
+        }
+        pending.apply(accumulator.finish().unwrap())
+      });
+
+    legacy_res.unwrap();
+    res.unwrap();
+    folded_res.unwrap();
+    assert_verifiers_equivalent(&legacy_verifier, &verifier);
+    assert_verifiers_equivalent(&legacy_verifier, &folded_verifier);
+    assert!(instance.generators.verify(legacy_verifier));
+    assert!(instance.generators.verify(verifier));
+    assert!(instance.generators.verify(folded_verifier));
+
+    // Malleate the proof, ensuring the verifiers still match and the proof is rejected
+    for _ in 0 .. 8 {
+      let mut proof = instance.proof.clone();
+      let i = usize::try_from(OsRng.next_u64() % u64::try_from(proof.len()).unwrap()).unwrap();
+      let existing_byte = proof[i];
+      while proof[i] == existing_byte {
+        proof[i] = u8::try_from(OsRng.next_u64() & u64::from(u8::MAX)).unwrap();
+      }
+
+      let (legacy_res, legacy_verifier) =
+        instance.verify_with(&rng, &proof, |rng, verifier, transcript| {
+          instance.statement().legacy_verify(rng, verifier, transcript)
+        });
+      let (res, verifier) = instance.verify_with(&rng, &proof, |rng, verifier, transcript| {
+        instance.statement().verify(rng, verifier, transcript)
+      });
+      assert_eq!(legacy_res, res);
+      if res.is_ok() {
+        assert_verifiers_equivalent(&legacy_verifier, &verifier);
+        assert!(!instance.generators.verify(legacy_verifier));
+        assert!(!instance.generators.verify(verifier));
+      }
+    }
+  }
+}
