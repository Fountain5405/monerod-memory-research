+/// Assert two batch verifiers are equivalent.
+///
+/// `additional` is only ever summed (within a multiexp), so its order is irrelevant. It's
+/// compared as a multiset.
+fn assert_verifiers_equivalent(a: &BatchVerifier<Ristretto>, b: &BatchVerifier<Ristretto>) {
+  assert_eq!(a.g, b.g);
+  assert_eq!(a.h, b.h);
+  assert_eq!(a.g_bold, b.g_bold);
+  assert_eq!(a.h_bold, b.h_bold);
+  assert_eq!(a.h_sum, b.h_sum);
+  let sorted = |additional: &[(F, G)]| {
+    let mut res = additional
+      .iter()
+      .map(|(scalar, point)| (scalar.to_repr(), point.to_bytes()))
+      .collect::<Vec<_>>();
+    res.sort_unstable();
+    res
+  };
+  assert_eq!(sorted(&a.additional), sorted(&b.additional));
+}
