+#[test]
+fn test_accumulator_matches_fold_constraints() {
+  for _ in 0 .. 50 {
+    let instance = Instance::random();
+    let statement = instance.statement();
+    let z = F::random(&mut OsRng);
+
+    let mut accumulator =
+      ConstraintAccumulator::<Ristretto>::new(N, instance.c, instance.m, z).unwrap();
+    for constraint in instance.constraints.clone() {
+      accumulator.push(constraint).unwrap();
+    }
+    assert_eq!(accumulator.q(), instance.constraints.len());
+    let accumulated = accumulator.finish().unwrap();
+    let stored = statement.fold_constraints(z);
+
+    assert_eq!(accumulated.n(), N);
+    assert_eq!(accumulated.c(), instance.c);
+    assert_eq!(accumulated.m(), instance.m);
+    assert_eq!(accumulated.z(), z);
+    assert_eq!(accumulated.q(), instance.constraints.len());
+    assert_eq!(accumulated.l_weights(), stored.l_weights());
+    assert_eq!(accumulated.r_weights(), stored.r_weights());
+    assert_eq!(accumulated.o_weights(), stored.o_weights());
+    for i in 0 .. instance.c {
+      assert_eq!(accumulated.cg_weights(i).unwrap(), stored.cg_weights(i).unwrap());
+    }
+    assert_eq!(accumulated.cg_weights(instance.c), None);
+    assert_eq!(accumulated.v_weights(), stored.v_weights());
+    assert_eq!(accumulated.c_sum(), stored.c_sum());
+    assert_eq!(accumulated, stored);
+
+    // Check against a naive folding, which doesn't truncate the vector commitments' weights
+    let (l, r, o, cg, v, c_sum) =
+      naive_fold(&instance.constraints, N, instance.c, instance.m, z);
+    assert_eq!(accumulated.l_weights(), l.as_slice());
+    assert_eq!(accumulated.r_weights(), r.as_slice());
+    assert_eq!(accumulated.o_weights(), o.as_slice());
+    for (i, cg) in cg.iter().enumerate() {
+      let truncated = accumulated.cg_weights(i).unwrap();
+      assert!(!truncated.is_empty());
+      // The truncation must only have elided zeroes
+      assert_eq!(truncated, &cg[.. truncated.len()]);
+      assert!(cg[truncated.len() ..].iter().all(|weight| bool::from(weight.is_zero())));
+      // The truncation must be to the highest index referenced, as `prove` truncates
+      let hi = instance
+        .constraints
+        .iter()
+        .filter_map(|constraint| constraint.WCG().get(&i))
+        .flat_map(|WCG| WCG.iter().map(|(j, _)| *j))
+        .max()
+        .unwrap_or(0);
+      assert_eq!(truncated.len(), hi + 1);
+    }
+    assert_eq!(accumulated.v_weights(), v.as_slice());
+    assert_eq!(accumulated.c_sum(), c_sum);
+  }
+}
