+    let c = C.len();
+    let m = V.len();
+    let witness = ArithmeticCircuitWitness::<Ristretto>::new(aL, aR, C, V).unwrap();
+    statement.prove(&mut OsRng, &mut transcript, witness).unwrap();
+    let proof = transcript.complete();
+
+    Instance { generators, constraints, commitments, c, m, proof }
+  }
+
+  fn statement(&self) -> ArithmeticCircuitStatement<'_, Ristretto> {
+    ArithmeticCircuitStatement::new(
+      self.generators.reduce(N).unwrap(),
+      self.constraints.clone(),
+      self.commitments.clone(),
+    )
+    .unwrap()
+  }
+
+  fn folded_statement(&self) -> FoldedStatement<'_, Ristretto> {
+    FoldedStatement::new(self.generators.reduce(N).unwrap(), self.commitments.clone()).unwrap()
+  }
+
+  // Run a verification function over a (potentially malleated) proof
+  fn verify_with(
+    &self,
+    rng: &DeterministicRng,
+    proof: &[u8],
+    verify: impl FnOnce(
+      &mut DeterministicRng,
+      &mut BatchVerifier<Ristretto>,
+      &mut VerifierTranscript,
+    ) -> Result<(), AcVerifyError>,
+  ) -> (Result<(), AcVerifyError>, BatchVerifier<Ristretto>) {
+    let mut rng = rng.clone();
+    let mut verifier = Generators::batch_verifier();
+    let mut transcript = VerifierTranscript::new([0; 32], proof);
+    let res = match transcript.read_commitments::<Ristretto>(self.c, self.m) {
+      Ok(_) => verify(&mut rng, &mut verifier, &mut transcript),
+      Err(_) => Err(AcVerifyError::IncompleteProof),
+    };
+    (res, verifier)
+  }
