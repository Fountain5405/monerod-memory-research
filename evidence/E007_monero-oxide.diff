+#[test]
+fn test_streaming_verify_rejects_tampered_proofs() {
+  let (G, T, U, V, params) = random_params(2);
+
+  // A C1 root (with branches on both curves) and a C2 root
+  for (paths, layers) in [(2, 3), (1, 2)] {
+    let (proof, root, inputs) = random_proof(&params, (G, T, U, V), paths, layers);
+    let mut buf = vec![];
+    proof.write(&mut buf).unwrap();
+
+    // Find the commitments' quantities
+    let (c1_commitments, c2_commitments) = {
+      let layout = Fcmp::<MoneroCurves>::verifier_layout(root, layers, paths);
+      (layout.c1_commitments, layout.c2_commitments)
+    };
+    let (c1_rows, c2_rows) = Fcmp::<MoneroCurves>::ipa_rows(paths, layers);
+
+    #[derive(Clone, Copy, Debug)]
+    enum Element {
+      C1Point,
+      C1Scalar,
+      C2Point,
+      C2Scalar,
+    }
+
+    // The offsets of a variety of elements within the serialized proof
+    let mut regions = vec![];
+    regions.push(("C1 vector commitment", 0, Element::C1Point));
+    if c2_commitments != 0 {
+      regions.push(("C2 vector commitment", 32 * c1_commitments, Element::C2Point));
+    }
+    let mut offset = 32 * (c1_commitments + c2_commitments);
+    for (name, c, rows, point, scalar) in [
+      ("C1", c1_commitments, c1_rows, Element::C1Point, Element::C1Scalar),
+      ("C2", c2_commitments, c2_rows, Element::C2Point, Element::C2Scalar),
+    ] {
+      let lr_len = usize::try_from(rows.ilog2()).unwrap();
+      let t_commitments = 3 * c + 5;
+      regions.push((name, offset, point)); // AI
+      regions.push((name, offset + 32, point)); // AO
+      regions.push((name, offset + 64, point)); // S
+      offset += 96;
+      regions.push((name, offset, point)); // The first T
+      regions.push((name, offset + (32 * (t_commitments - 1)), point)); // The last T
+      offset += 32 * t_commitments;
+      regions.push((name, offset, scalar)); // tau_x
+      regions.push((name, offset + 32, scalar)); // mu
+      regions.push((name, offset + 64, scalar)); // t_caret
+      offset += 96;
+      regions.push((name, offset, point)); // The first L
+      regions.push((name, offset + (32 * ((2 * lr_len) - 1)), point)); // The last R
+      offset += 64 * lr_len;
+      regions.push((name, offset, scalar)); // a
+      regions.push((name, offset + 32, scalar)); // b
+      offset += 64;
+    }
+    // Sanity check our offsets by checking we've reached the root blind PoK
+    assert_eq!(offset + 64, buf.len());
+    let (pok_point, pok_scalar) = match root {
+      TreeRoot::C1(_) => (Element::C1Point, Element::C1Scalar),
+      TreeRoot::C2(_) => (Element::C2Point, Element::C2Scalar),
+    };
+    regions.push(("root blind PoK", offset, pok_point));
+    regions.push(("root blind PoK", offset + 32, pok_scalar));
+
+    for (name, offset, element) in regions {
+      // Replace the element with another valid element, and flip a bit within it
+      let replacement = match element {
+        Element::C1Point => <Selene as Ciphersuite>::G::random(&mut OsRng).to_bytes(),
+        Element::C1Scalar => <Selene as Ciphersuite>::F::random(&mut OsRng).to_repr(),
+        Element::C2Point => <Helios as Ciphersuite>::G::random(&mut OsRng).to_bytes(),
+        Element::C2Scalar => <Helios as Ciphersuite>::F::random(&mut OsRng).to_repr(),
+      };
+      let mut replaced = buf.clone();
+      replaced[offset .. (offset + 32)].copy_from_slice(&replacement);
+      let mut flipped = buf.clone();
+      flipped[offset + 1] ^= 1;
+
+      for tampered in [replaced, flipped] {
+        assert_ne!(tampered, buf);
+        let tampered = Fcmp::<MoneroCurves>::read(&mut tampered.as_slice(), paths, layers).unwrap();
+        let ((streaming, streaming_1, streaming_2), (stored, stored_1, stored_2)) =
+          verify_both(&tampered, &params, root, layers, &inputs);
+        // The same transcript operations are performed, so the same proofs are well-formed
+        assert_eq!(streaming.is_ok(), stored.is_ok(), "{name} {element:?}");
+        if streaming.is_ok() {
+          assert_verifiers_eq(&streaming_1, &stored_1);
+          assert_verifiers_eq(&streaming_2, &stored_2);
+          assert!(!batch_verifies(&params, &streaming_1, &streaming_2), "{name} {element:?}");
+          assert!(!batch_verifies(&params, &stored_1, &stored_2), "{name} {element:?}");
+        }
+      }
+    }
+  }
+}
