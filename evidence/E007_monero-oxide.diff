+// `Circuit` has a single type for all modes, as the gadgets are written against it, so the
+// inability of a discarding or accumulating circuit to produce a statement is enforced at runtime
+#[test]
+fn test_only_storing_circuits_produce_statements() {
+  use generalized_bulletproofs::arithmetic_circuit_proof::ConstraintAccumulator;
+  use generalized_bulletproofs_circuit_abstraction::{Circuit, CircuitError};
+
+  let generators =
+    generalized_bulletproofs::tests::insecure_test_generators::<_, Selene>(&mut OsRng, 2).unwrap();
+  let commitments = ProverTranscript::new([0; 32]).write_commitments::<Selene>(vec![], vec![]);
+
+  let populate = |circuit: &mut Circuit<Selene>| {
+    let (l, r, _o) = circuit.mul(Some(LinComb::empty()), Some(LinComb::empty()), None);
+    circuit.constrain_equal_to_zero(LinComb::from(l) - &LinComb::from(r));
+  };
+
+  let mut storing = Circuit::<Selene>::verify();
+  populate(&mut storing);
+  assert_eq!(storing.muls(), 1);
+  assert_eq!(storing.constraints_pushed(), 3);
+  storing.clone().statement(generators.reduce(2).unwrap(), commitments.clone()).unwrap();
+  assert_eq!(storing.finish_accumulate(), Err(CircuitError::ConstraintsNotAccumulated));
+
+  let mut discarding = Circuit::<Selene>::verify_discarding();
+  populate(&mut discarding);
+  assert_eq!(discarding.muls(), 1);
+  assert_eq!(discarding.constraints_pushed(), 3);
+  assert_eq!(
+    discarding.clone().statement(generators.reduce(2).unwrap(), commitments.clone()).map(|_| ()),
+    Err(CircuitError::ConstraintsNotStored)
+  );
+  assert_eq!(discarding.finish_accumulate(), Err(CircuitError::ConstraintsNotAccumulated));
+
+  let z = <Selene as Ciphersuite>::F::random(&mut OsRng);
+  let mut accumulating =
+    Circuit::<Selene>::verify_accumulating(ConstraintAccumulator::new(2, 0, 0, z).unwrap());
+  populate(&mut accumulating);
+  assert_eq!(accumulating.muls(), 1);
+  assert_eq!(accumulating.constraints_pushed(), 3);
+  assert_eq!(
+    accumulating.clone().statement(generators.reduce(2).unwrap(), commitments.clone()).map(|_| ()),
+    Err(CircuitError::ConstraintsNotStored)
+  );
+  assert_eq!(accumulating.finish_accumulate().unwrap().q(), 3);
+
+  // A constraint referencing a non-existent term poisons the accumulator
+  let mut accumulating =
+    Circuit::<Selene>::verify_accumulating(ConstraintAccumulator::new(2, 0, 0, z).unwrap());
+  accumulating.constrain_equal_to_zero(LinComb::from(Variable::aL(2)));
+  populate(&mut accumulating);
+  assert_eq!(
+    accumulating.finish_accumulate(),
+    Err(CircuitError::AcStatementError(AcStatementError::ConstrainedNonExistentTerm))
+  );
+
+  assert!(matches!(
+    FcmpError::from(CircuitError::ConstraintsNotStored),
+    FcmpError::CircuitError(CircuitError::ConstraintsNotStored)
+  ));
+  assert!(matches!(
+    FcmpError::from(CircuitError::AcStatementError(AcStatementError::TooManyCommitments)),
+    FcmpError::AcStatementError(AcStatementError::TooManyCommitments)
+  ));
+}
