+#[test]
+fn test_accumulated_constraints_match_stored() {
+  use generalized_bulletproofs::arithmetic_circuit_proof::{ConstraintAccumulator, FoldedStatement};
+
+  let (G, T, U, V, params) = random_params(2);
+
+  for (paths, layers) in [(2, 3), (1, 4)] {
+    let (proof, root, inputs) = random_proof(&params, (G, T, U, V), paths, layers);
+
+    let mut verifier_1 = generalized_bulletproofs::Generators::batch_verifier();
+    let mut verifier_2 = generalized_bulletproofs::Generators::batch_verifier();
+    let (layout, transcript, proof_1_vcs, proof_2_vcs) = proof
+      .verify_prelude(&mut OsRng, &mut verifier_1, &mut verifier_2, &params, root, layers, &inputs)
+      .unwrap();
+    let c1_generators = params.curve_1_generators.reduce(layout.c1_padded_pow_2).unwrap();
+    let c2_generators = params.curve_2_generators.reduce(layout.c2_padded_pow_2).unwrap();
+    let replay_layout = Fcmp::<MoneroCurves>::verifier_layout(root, layers, inputs.len());
+    let c1_n = FoldedStatement::new(c1_generators, proof_1_vcs.clone()).unwrap().n();
+    let c2_n = FoldedStatement::new(c2_generators, proof_2_vcs.clone()).unwrap().n();
+
+    // Build the circuits, storing their constraints
+    let mut stored_transcript = transcript.clone();
+    let mut c1_stored = Circuit::<Selene>::verify();
+    let mut c2_stored = Circuit::<Helios>::verify();
+    Fcmp::<MoneroCurves>::build_verifier_circuits(
+      &params,
+      layers,
+      &inputs,
+      layout,
+      &proof_1_vcs,
+      &proof_2_vcs,
+      &mut stored_transcript,
+      &mut c1_stored,
+      &mut c2_stored,
+    )
+    .unwrap();
+
+    // Build the circuits, accumulating their constraints
+    let z_1 = <Selene as Ciphersuite>::F::random(&mut OsRng);
+    let z_2 = <Helios as Ciphersuite>::F::random(&mut OsRng);
+    let mut accumulated_transcript = transcript.clone();
+    let mut c1_accumulated = Circuit::<Selene>::verify_accumulating(
+      ConstraintAccumulator::new(c1_n, proof_1_vcs.C().len(), 0, z_1).unwrap(),
+    );
+    let mut c2_accumulated = Circuit::<Helios>::verify_accumulating(
+      ConstraintAccumulator::new(c2_n, proof_2_vcs.C().len(), 0, z_2).unwrap(),
+    );
+    Fcmp::<MoneroCurves>::build_verifier_circuits(
+      &params,
+      layers,
+      &inputs,
+      replay_layout,
+      &proof_1_vcs,
+      &proof_2_vcs,
+      &mut accumulated_transcript,
+      &mut c1_accumulated,
+      &mut c2_accumulated,
+    )
+    .unwrap();
+
+    Fcmp::<MoneroCurves>::check_replay(
+      (&c1_stored, &c2_stored, &stored_transcript),
+      (&c1_accumulated, &c2_accumulated, &accumulated_transcript),
+    )
+    .unwrap();
+    let c1_constraints = c1_stored.constraints_pushed();
+    let c2_constraints = c2_stored.constraints_pushed();
+    assert!(c1_constraints != 0);
+    assert_eq!(c2_constraints != 0, layers > 1);
+
+    let c1_accumulated = c1_accumulated.finish_accumulate().unwrap();
+    let c2_accumulated = c2_accumulated.finish_accumulate().unwrap();
+    let (c1_statement, _witness) = c1_stored.statement(c1_generators, proof_1_vcs.clone()).unwrap();
+    let (c2_statement, _witness) = c2_stored.statement(c2_generators, proof_2_vcs.clone()).unwrap();
+    let c1_stored = c1_statement.fold_constraints(z_1);
+    let c2_stored = c2_statement.fold_constraints(z_2);
+
+    assert_eq!(c1_accumulated.q(), c1_constraints);
+    assert_eq!(c1_accumulated.l_weights(), c1_stored.l_weights());
+    assert_eq!(c1_accumulated.r_weights(), c1_stored.r_weights());
+    assert_eq!(c1_accumulated.o_weights(), c1_stored.o_weights());
+    for i in 0 .. proof_1_vcs.C().len() {
+      assert_eq!(c1_accumulated.cg_weights(i).unwrap(), c1_stored.cg_weights(i).unwrap());
+    }
+    assert_eq!(c1_accumulated.v_weights(), c1_stored.v_weights());
+    assert_eq!(c1_accumulated.c_sum(), c1_stored.c_sum());
+    assert_eq!(c1_accumulated, c1_stored);
+
+    assert_eq!(c2_accumulated.q(), c2_constraints);
+    assert_eq!(c2_accumulated.l_weights(), c2_stored.l_weights());
+    assert_eq!(c2_accumulated.r_weights(), c2_stored.r_weights());
+    assert_eq!(c2_accumulated.o_weights(), c2_stored.o_weights());
+    for i in 0 .. proof_2_vcs.C().len() {
+      assert_eq!(c2_accumulated.cg_weights(i).unwrap(), c2_stored.cg_weights(i).unwrap());
+    }
+    assert_eq!(c2_accumulated.v_weights(), c2_stored.v_weights());
+    assert_eq!(c2_accumulated.c_sum(), c2_stored.c_sum());
+    assert_eq!(c2_accumulated, c2_stored);
+  }
+}
