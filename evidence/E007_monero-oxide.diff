+#[test]
+fn test_replay_check_detects_divergence() {
+  let proof = [0; 64];
+  let transcript = VerifierTranscript::new([0; 32], &proof);
+
+  let build = |extra_c1_constraint: bool, extra_c2_mul: bool, extra_challenge: bool| {
+    let mut transcript = transcript.clone();
+    let mut c1 = Circuit::<Selene>::verify_discarding();
+    let mut c2 = Circuit::<Helios>::verify_discarding();
+    let _ = transcript.challenge::<Selene>();
+    c1.mul(None, None, None);
+    c1.constrain_equal_to_zero(LinComb::empty());
+    c2.mul(None, None, None);
+    if extra_c1_constraint {
+      c1.constrain_equal_to_zero(LinComb::empty());
+    }
+    if extra_c2_mul {
+      c2.mul(None, None, None);
+    }
+    if extra_challenge {
+      let _ = transcript.challenge_bytes();
+    }
+    (c1, c2, transcript)
+  };
+
+  let (c1, c2, transcript) = build(false, false, false);
+  for (extra_c1_constraint, extra_c2_mul, extra_challenge) in [
+    (false, false, false),
+    (true, false, false),
+    (false, true, false),
+    (false, false, true),
+    (true, true, true),
+  ] {
+    let (replay_c1, replay_c2, replay_transcript) =
+      build(extra_c1_constraint, extra_c2_mul, extra_challenge);
+    let res = Fcmp::<MoneroCurves>::check_replay(
+      (&c1, &c2, &transcript),
+      (&replay_c1, &replay_c2, &replay_transcript),
+    );
+    if extra_c1_constraint || extra_c2_mul || extra_challenge {
+      assert!(matches!(res, Err(FcmpError::InconsistentCircuitReplay)));
+    } else {
+      res.unwrap();
+    }
+  }
+}
