+    // The layout is consumed when building the circuits, so we recompute it for the replay
+    let replay_layout = Self::verifier_layout(tree, layers, inputs.len());
+
+    /*
+      The verifier only uses the circuits' constraints after folding them with each proof's `z`
+      challenge, which is only available after the circuits are built (as it's sampled after the
+      challenges the circuits sample). Instead of storing the constraints until `z` is available,
+      we build the circuits twice:
+
+      1) On the transcript, discarding the constraints. This performs the exact same transcript
+         operations as building the circuits with their constraints stored would.
+      2) After the proofs' transcripts are processed (yielding `z`), on a copy of the transcript
+         as it was prior to building the circuits, folding the constraints as they're produced.
+
+      As building the circuits is deterministic to the same arguments and transcript state, both
+      constructions produce the same constraints, which we check (to the extent we're able to)
+      before using the folded constraints.
+    */
+    let mut replay_transcript = transcript.clone();
+
+    let mut c1_circuit = Circuit::<C::C1>::verify_discarding();
+    let mut c2_circuit = Circuit::<C::C2>::verify_discarding();
+    Self::build_verifier_circuits(
+      params,
+      layers,
+      inputs,
+      layout,
+      &proof_1_vcs,
+      &proof_2_vcs,
+      &mut transcript,
+      &mut c1_circuit,
+      &mut c2_circuit,
+    )?;
+    let transcript_after_build = transcript.clone();
+
+    // Process the proofs' transcripts, which queues everything not dependent on the constraints
+    let c1_pending = FoldedStatement::new(c1_generators, proof_1_vcs.clone())?.verify_transcript(
+      rng,
+      verifier_1,
+      &mut transcript,
+    )?;
+    let c2_pending = FoldedStatement::new(c2_generators, proof_2_vcs.clone())?.verify_transcript(
+      rng,
+      verifier_2,
+      &mut transcript,
+    )?;
+
+    // Rebuild the circuits, folding their constraints with each proof's `z` challenge
+    let mut c1_replay = Circuit::<C::C1>::verify_accumulating(c1_pending.accumulator()?);
+    let mut c2_replay = Circuit::<C::C2>::verify_accumulating(c2_pending.accumulator()?);
+    Self::build_verifier_circuits(
+      params,
+      layers,
+      inputs,
+      replay_layout,
+      &proof_1_vcs,
+      &proof_2_vcs,
+      &mut replay_transcript,
+      &mut c1_replay,
+      &mut c2_replay,
+    )?;
+    Self::check_replay(
+      (&c1_circuit, &c2_circuit, &transcript_after_build),
+      (&c1_replay, &c2_replay, &replay_transcript),
+    )?;
+
+    let c1_folded = c1_replay.finish_accumulate()?;
+    let c2_folded = c2_replay.finish_accumulate()?;
+    if (c1_folded.q() != c1_circuit.constraints_pushed()) ||
+      (c2_folded.q() != c2_circuit.constraints_pushed())
+    {
+      Err(FcmpError::InconsistentCircuitReplay)?;
+    }
+
+    // If either of these aren't reached, the pending verification will corrupt its verifier
+    c1_pending.apply(c1_folded)?;
+    c2_pending.apply(c2_folded)?;
+
+    Ok(())
+  }
+
+  /// Verify an FCMP while storing the circuits' constraints, as `Fcmp::verify` historically did.
+  ///
+  /// This performs the exact same transcript operations, and samples the same randomness, as
