+
+/// Fold stored constraints with the challenge `z_1`.
+///
+/// This performs the exact folding `ArithmeticCircuitStatement::verify` has historically performed
+/// over its stored constraints, with the vector commitments' weights truncated as
+/// `ArithmeticCircuitStatement::prove` truncates them.
+fn fold_stored_constraints<C: Ciphersuite>(
+  constraints: &[LinComb<C::F>],
+  n: usize,
+  c: usize,
+  m: usize,
+  z_1: C::F,
+) -> FoldedConstraints<C> {
+  // Powers of z *starting with z**1*, exactly as `yz_challenges` calculates them
+  let q = constraints.len();
+  let mut z = ScalarVector(Vec::with_capacity(q));
+  z.0.push(z_1);
+  for _ in 1 .. q {
+    z.0.push(*z.0.last().expect("always non-empty Vec didn't have a last element") * z_1);
+  }
+  z.0.truncate(q);
+
+  let mut l_weights = ScalarVector::new(n);
+  let mut r_weights = ScalarVector::new(n);
+  let mut o_weights = ScalarVector::new(n);
+  for (constraint, z) in constraints.iter().zip(&z.0) {
+    accumulate_vector(&mut l_weights, &constraint.WL, *z);
+    accumulate_vector(&mut r_weights, &constraint.WR, *z);
+    accumulate_vector(&mut o_weights, &constraint.WO, *z);
+  }
+
+  let c_sum = z.inner_product(constraints.iter().map(|constraint| &constraint.c));
+
+  let mut v_weights = ScalarVector::new(m);
+  for (constraint, z) in constraints.iter().zip(&z.0) {
+    accumulate_vector(&mut v_weights, &constraint.WV, *z);
+  }
+
+  let mut cg_weights = Vec::with_capacity(c);
+  for i in 0 .. c {
+    let mut cg = ScalarVector::new(n);
+    let mut cg_hi = 0;
+    for (constraint, z) in constraints.iter().zip(&z.0) {
+      if let Some(WCG) = constraint.WCG().get(&i) {
+        cg_hi = cg_hi.max(accumulate_vector(&mut cg, WCG, *z));
+      }
+    }
+    cg.0.truncate(cg_hi + 1);
+    // Release the truncated capacity, as we retain all of these vectors at once
+    cg.0.shrink_to_fit();
+    cg_weights.push(cg);
+  }
+
+  FoldedConstraints { n, z: z_1, q, l_weights, r_weights, o_weights, cg_weights, v_weights, c_sum }
+}
+
+/// The constraints of an arithmetic circuit, folded into the weighted sums used for verification.
+///
+/// For the statement's challenge `z`, the `k`-th constraint (zero-indexed) is weighted by
+/// `z**(k + 1)` and the weighted constraints are summed. This is all the verifier uses of the
+/// constraints.
+///
+/// This is only obtainable via `ConstraintAccumulator::finish` or
+/// `ArithmeticCircuitStatement::fold_constraints`.
+#[derive(Clone, PartialEq, Eq, Debug)]
+pub struct FoldedConstraints<C: Ciphersuite> {
+  n: usize,
+  z: C::F,
+  q: usize,
+  // These have length `n`
+  l_weights: ScalarVector<C::F>,
+  r_weights: ScalarVector<C::F>,
+  o_weights: ScalarVector<C::F>,
+  /*
+    One per vector commitment, each truncated after the highest index any constraint referenced
+    for that commitment (yet never to a length less than one), as `prove` truncates them. All
+    elided values are zero. As the vector commitments for the branches of a tree only use a few
+    of their indexes, this saves a notable amount of memory.
+  */
+  cg_weights: Vec<ScalarVector<C::F>>,
+  // This has length `m`
+  v_weights: ScalarVector<C::F>,
+  c_sum: C::F,
+}
+
+impl<C: Ciphersuite> FoldedConstraints<C> {
+  /// The amount of rows (generators) these constraints were folded for.
+  pub fn n(&self) -> usize {
+    self.n
+  }
+  /// The amount of Pedersen vector commitments these constraints were folded for.
+  pub fn c(&self) -> usize {
+    self.cg_weights.len()
+  }
+  /// The amount of Pedersen commitments these constraints were folded for.
+  pub fn m(&self) -> usize {
+    self.v_weights.len()
+  }
+  /// The challenge `z` these constraints were folded with.
+  pub fn z(&self) -> C::F {
+    self.z
+  }
+  /// The amount of constraints folded.
+  pub fn q(&self) -> usize {
+    self.q
+  }
+  /// The folded weights for `aL`, of length `n`.
+  pub fn l_weights(&self) -> &[C::F] {
+    &self.l_weights.0
+  }
+  /// The folded weights for `aR`, of length `n`.
+  pub fn r_weights(&self) -> &[C::F] {
+    &self.r_weights.0
+  }
+  /// The folded weights for `aO`, of length `n`.
+  pub fn o_weights(&self) -> &[C::F] {
+    &self.o_weights.0
+  }
+  /// The folded weights for the `i`-th Pedersen vector commitment.
+  ///
+  /// These are truncated after the highest index any constraint referenced for this commitment
+  /// (yet are never of length less than one). All elided values are zero.
+  pub fn cg_weights(&self, i: usize) -> Option<&[C::F]> {
+    self.cg_weights.get(i).map(|cg| cg.0.as_slice())
+  }
+  /// The folded weights for the Pedersen commitments, of length `m`.
+  pub fn v_weights(&self) -> &[C::F] {
+    &self.v_weights.0
+  }
+  /// The folded constants.
+  pub fn c_sum(&self) -> C::F {
+    self.c_sum
+  }
+}
+
+/// An accumulator which folds constraints, as they're produced, into the weighted sums used for
+/// verification.
+///
+/// This allows verifying an arithmetic circuit proof without ever storing its constraints. Pushing
+/// a list of constraints into an accumulator created with the challenge `z` yields the same
+/// `FoldedConstraints` `ArithmeticCircuitStatement::fold_constraints` does for a statement with
+/// those constraints. The same checks `ArithmeticCircuitStatement::new` performs on the
+/// constraints are performed by `push` and `finish`.
+///
+/// Upon an error, the accumulator retains the error and solely returns it from then on.
+#[derive(Clone, PartialEq, Eq, Debug)]
+pub struct ConstraintAccumulator<C: Ciphersuite> {
+  n: usize,
+  z: C::F,
+  // `z**(q + 1)`, the weight for the next constraint
+  next_weight: C::F,
+  q: usize,
+  error: Option<AcStatementError>,
+  individually_constrained: Vec<bool>,
+  l_weights: ScalarVector<C::F>,
+  r_weights: ScalarVector<C::F>,
+  o_weights: ScalarVector<C::F>,
+  cg_weights: Vec<ScalarVector<C::F>>,
+  v_weights: ScalarVector<C::F>,
+  c_sum: C::F,
+}
+
+impl<C: Ciphersuite> ConstraintAccumulator<C> {
+  /// Create a new accumulator.
+  ///
+  /// `n` is the amount of rows (generators), `c` the amount of Pedersen vector commitments, `m`
+  /// the amount of Pedersen commitments, and `z` the statement's `z` challenge. For accumulating
+  /// the constraints of a proof being verified, use `PendingVerification::accumulator`.
+  pub fn new(n: usize, c: usize, m: usize, z: C::F) -> Result<Self, AcStatementError> {
+    // The check `ArithmeticCircuitStatement::new` performs, performed here prior to allocating
+    if c >= (usize::MAX >> 4) {
+      Err(AcStatementError::TooManyCommitments)?;
+    }
+
+    Ok(Self {
+      n,
+      z,
+      next_weight: z,
+      q: 0,
+      error: None,
+      individually_constrained: vec![false; m],
+      l_weights: ScalarVector::new(n),
+      r_weights: ScalarVector::new(n),
+      o_weights: ScalarVector::new(n),
+      // These grow as needed, starting at the minimum length `prove`'s truncation leaves
+      cg_weights: (0 .. c).map(|_| ScalarVector::new(1)).collect(),
+      v_weights: ScalarVector::new(m),
+      c_sum: C::F::ZERO,
+    })
+  }
+
+  /// The amount of constraints successfully pushed.
+  pub fn q(&self) -> usize {
+    self.q
+  }
+
+  /// Fold a constraint into this accumulator.
+  ///
+  /// The constraint is bound to evaluate to `0`, as with `ArithmeticCircuitStatement::new`.
+  // This takes the constraint by value so it's dropped once folded, as it's no longer needed
+  #[allow(clippy::needless_pass_by_value)]
+  pub fn push(&mut self, constraint: LinComb<C::F>) -> Result<(), AcStatementError> {
+    if let Some(err) = self.error {
+      Err(err)?;
+    }
+
+    // The checks `ArithmeticCircuitStatement::new` performs on each constraint, in the same order
+    let check = if Some(self.n) <= constraint.highest_a_index {
+      Err(AcStatementError::ConstrainedNonExistentTerm)
+    } else if Some(self.cg_weights.len()) <= constraint.highest_c_index {
+      Err(AcStatementError::ConstrainedNonExistentVectorCommitment)
+    } else if Some(self.v_weights.len()) <= constraint.highest_v_index {
+      Err(AcStatementError::ConstrainedNonExistentCommitment)
+    } else {
+      Ok(())
+    };
+    if let Err(err) = check {
+      self.error = Some(err);
+      Err(err)?;
+    }
+    if (constraint.WV.len() == 1) && bool::from(!constraint.WV[0].1.is_zero()) {
+      self.individually_constrained[constraint.WV[0].0] = true;
+    }
+
+    // All indexes are now known to be in-bounds
+    let z = self.next_weight;
+    accumulate_vector(&mut self.l_weights, &constraint.WL, z);
+    accumulate_vector(&mut self.r_weights, &constraint.WR, z);
+    accumulate_vector(&mut self.o_weights, &constraint.WO, z);
+    for (i, WCG) in constraint.WCG() {
+      let cg = &mut self.cg_weights[*i];
+      // Grow to include the highest index referenced, matching `prove`'s truncation
+      if let Some(hi) = WCG.iter().map(|(j, _)| *j).max() {
+        if cg.len() <= hi {
+          cg.0.resize(hi + 1, C::F::ZERO);
+        }
+      }
+      accumulate_vector(cg, WCG, z);
+    }
+    accumulate_vector(&mut self.v_weights, &constraint.WV, z);
+    self.c_sum += z * constraint.c;
+
+    self.q += 1;
+    self.next_weight *= self.z;
+    Ok(())
+  }
+
+  /// Finish accumulating, performing the checks `ArithmeticCircuitStatement::new` performs after
+  /// iterating over the constraints.
+  pub fn finish(self) -> Result<FoldedConstraints<C>, AcStatementError> {
+    if let Some(err) = self.error {
+      Err(err)?;
+    }
+    if self.individually_constrained.iter().any(|constrained| !constrained) {
+      Err(AcStatementError::DidNotConstrainCommitment)?;
+    }
+
+    let ConstraintAccumulator {
+      n,
+      z,
+      next_weight: _,
+      q,
+      error: _,
+      individually_constrained: _,
+      l_weights,
+      r_weights,
+      o_weights,
+      cg_weights,
+      v_weights,
+      c_sum,
+    } = self;
+    Ok(FoldedConstraints { n, z, q, l_weights, r_weights, o_weights, cg_weights, v_weights, c_sum })
+  }
+}
+
+/// An arithmetic circuit statement whose constraints are provided folded, after the proof's
+/// transcript has been processed.
+///
+/// This enables verifying a proof without storing the statement's constraints. The transcript is
+/// processed (`FoldedStatement::verify_transcript`), yielding the challenge `z`. Then, the
+/// constraints are folded with `z` as they're produced (`PendingVerification::accumulator`), and
+/// the folded constraints are applied (`PendingVerification::apply`).
+///
+/// The caller is responsible for folding exactly the constraints of the intended relation. If
+/// other constraints are folded (such as no constraints at all), the proof is verified for that
+/// other relation (which may be trivially satisfiable).
+#[derive(Clone, Debug)]
+pub struct FoldedStatement<'a, C: Ciphersuite> {
+  generators: ProofGenerators<'a, C>,
+  C: PointVector<C>,
+  V: PointVector<C>,
+}
+
+impl<'a, C: Ciphersuite> FoldedStatement<'a, C> {
+  /// Create a new `FoldedStatement`.
+  ///
+  /// The same context as for `ArithmeticCircuitStatement::new` applies, except the constraints
+  /// are checked as they're folded (by `ConstraintAccumulator`).
+  pub fn new(
+    generators: ProofGenerators<'a, C>,
+    commitments: Commitments<C>,
+  ) -> Result<Self, AcStatementError> {
+    let Commitments { C, V } = commitments;
+    // The check `ArithmeticCircuitStatement::new` performs on the commitments
+    if C.len() >= (usize::MAX >> 4) {
+      Err(AcStatementError::TooManyCommitments)?;
+    }
+    Ok(Self { generators, C, V })
+  }
+
+  /// The amount of rows within the resulting inner-product argument.
+  pub fn n(&self) -> usize {
+    self.generators.len()
+  }
+
+  /// The amount of Pedersen vector commitments.
+  pub fn c(&self) -> usize {
+    self.C.len()
+  }
+
+  /// The amount of Pedersen commitments.
+  pub fn m(&self) -> usize {
+    self.V.len()
+  }
 }
 
