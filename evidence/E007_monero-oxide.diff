+/// Fold constraints naively, with explicitly calculated powers of `z`.
+#[allow(clippy::type_complexity)]
+fn naive_fold(
+  constraints: &[LinComb<F>],
+  n: usize,
+  c: usize,
+  m: usize,
+  z: F,
+) -> (Vec<F>, Vec<F>, Vec<F>, Vec<Vec<F>>, Vec<F>, F) {
+  let mut l = vec![F::ZERO; n];
+  let mut r = vec![F::ZERO; n];
+  let mut o = vec![F::ZERO; n];
+  let mut cg = vec![vec![F::ZERO; n]; c];
+  let mut v = vec![F::ZERO; m];
+  let mut c_sum = F::ZERO;
+  for (k, constraint) in constraints.iter().enumerate() {
+    // The first constraint is weighted by `z**1`
+    let z = z.pow_vartime([u64::try_from(k + 1).unwrap()]);
+    for (i, weight) in constraint.WL() {
+      l[*i] += *weight * z;
+    }
+    for (i, weight) in constraint.WR() {
+      r[*i] += *weight * z;
+    }
+    for (i, weight) in constraint.WO() {
+      o[*i] += *weight * z;
+    }
+    for (i, WCG) in constraint.WCG() {
+      for (j, weight) in WCG {
+        cg[*i][*j] += *weight * z;
+      }
+    }
+    for (i, weight) in constraint.WV() {
+      v[*i] += *weight * z;
+    }
+    c_sum += constraint.c() * z;
+  }
+  (l, r, o, cg, v, c_sum)
+}
