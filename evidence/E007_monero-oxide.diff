+impl<C: Ciphersuite> PendingVerification<'_, C> {
+  /// The amount of rows within the inner-product argument.
+  pub fn n(&self) -> usize {
+    self.n
+  }
+
+  /// The amount of Pedersen vector commitments.
+  pub fn c(&self) -> usize {
+    self.c
+  }
+
+  /// The amount of Pedersen commitments.
+  pub fn m(&self) -> usize {
+    self.m
+  }
+
+  /// The statement's challenge `z`, which the constraints must be folded with.
+  pub fn z(&self) -> C::F {
+    self.z
+  }
+
+  /// Create a `ConstraintAccumulator` to fold this statement's constraints with.
+  pub fn accumulator(&self) -> Result<ConstraintAccumulator<C>, AcStatementError> {
+    ConstraintAccumulator::new(self.n, self.c, self.m, self.z)
+  }
+
+  /// Apply the statement's folded constraints, completing the queueing of this proof for batch
+  /// verification.
+  ///
+  /// If this function returns an error, the BatchVerifier MUST be assumed corrupted and discarded.
+  pub fn apply(mut self, folded: FoldedConstraints<C>) -> Result<(), AcVerifyError> {
+    let n = self.n;
+    let c = self.c;
+
+    // Check these constraints were folded for this statement, so the following can't panic
+    if (folded.n != n) ||
+      (folded.l_weights.len() != n) ||
+      (folded.r_weights.len() != n) ||
+      (folded.o_weights.len() != n) ||
+      (folded.cg_weights.len() != c) ||
+      folded.cg_weights.iter().any(|cg| cg.len() > n) ||
+      (folded.v_weights.len() != self.m) ||
+      (folded.z != self.z)
+    {
+      Err(AcVerifyError::InconsistentFoldedConstraints)?;
+    }
+
+    let FoldedConstraints {
+      n: _,
+      z: _,
+      q: _,
+      l_weights,
+      r_weights,
+      o_weights,
+      cg_weights,
+      v_weights,
+      c_sum,
+    } = folded;
+    let V = core::mem::replace(&mut self.V, PointVector(vec![]));
+    let verifier = &mut *self.verifier;
+
+    let ni = (2 * c) + 2;
+
+    let ilr = ni / 2;
+    let jo = 0;
+
+    let r_weights = r_weights * &self.y_inv;
+
+    let delta = r_weights.inner_product(l_weights.0.iter());
+
+    // The remainder of the verifier's final Step 4 in the 'fixed' paper
+    {
+      let verifier_weight = self.t_verifier_weight;
+
+      /*
+        `delta - z...`, instead of `delta + z...`, is because we write our constraint as
+        `+ c = 0`, not `= c`, so we have to subtract it from both sides, which this effects.
+      */
+      verifier.g -= verifier_weight * self.x_ni * (delta - c_sum);
+      let V_weights = v_weights * self.x_ni;
+      for pair in V_weights.0.into_iter().zip(V.0) {
+        /*
+          We actually don't negate `verifier_weight` here as we write our constraint as
+          `... + WV V = 0` not `= WV V + ..`. This means we need to subtract it from both sides,
+          which this effects.
+        */
+        verifier.additional.push((verifier_weight * pair.0, pair.1));
+      }
+    }
+
+    // The remainder of the verifier's final Steps 3, 5 in the 'fixed' paper
+    {
+      let x = &self.weighted_x;
+
+      // Lines 85-87 calculate `WL`, `WR`, `WO`
+      // We preserve them in terms of `g_bold` and `h_bold` for a more efficient multiexp
+      let mut h_bold_scalars = l_weights * x[ilr];
+      for (i, wr) in (r_weights * x[ilr]).0.into_iter().enumerate() {
+        verifier.g_bold[i] += wr;
+      }
+      h_bold_scalars = h_bold_scalars + &(o_weights * x[jo]);
+
+      // The terms for `WC`, which decrement from `n'`
+      for (i, WCG) in cg_weights.into_iter().enumerate() {
+        let i = 1 + i;
+        // `WCG` may be shorter than `h_bold_scalars`, yet all elided values are zero
+        for (dest, weight) in h_bold_scalars.0.iter_mut().zip(WCG.0) {
+          *dest += weight * x[i];
+        }
+      }
+
+      // All terms for `h_bold` here have actually been for `h_bold'`, `h_bold * y^{-1}`
+      h_bold_scalars = h_bold_scalars * &self.y_inv;
+      for (i, scalar) in h_bold_scalars.0.into_iter().enumerate() {
+        verifier.h_bold[i] += scalar;
+      }
+    }
+
+    self.applied = true;
+    Ok(())
+  }
+}
