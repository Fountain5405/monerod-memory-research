+#[test]
+fn test_accumulator_errors_match_statement_new() {
+  const N: usize = 4;
+  let generators = insecure_test_generators::<_, Ristretto>(&mut OsRng, N).unwrap();
+  let commitments = Transcript::new([0; 32])
+    .write_commitments::<Ristretto>(vec![G::random(&mut OsRng)], vec![G::random(&mut OsRng)]);
+  let v = || LinComb::empty().term(F::ONE, Variable::V(0));
+
+  #[allow(clippy::type_complexity)]
+  let cases: Vec<(Vec<LinComb<F>>, Result<(), AcStatementError>)> = vec![
+    (vec![v()], Ok(())),
+    (vec![v(), LinComb::from(Variable::aL(N - 1)), LinComb::from(Variable::aO(N - 1))], Ok(())),
+    (
+      vec![v(), LinComb::from(Variable::CG { commitment: 0, index: N - 1 }).constant(F::ONE)],
+      Ok(()),
+    ),
+    (vec![v(), LinComb::from(Variable::aL(N))], Err(AcStatementError::ConstrainedNonExistentTerm)),
+    (vec![LinComb::from(Variable::aR(N)), v()], Err(AcStatementError::ConstrainedNonExistentTerm)),
+    (vec![v(), LinComb::from(Variable::aO(N))], Err(AcStatementError::ConstrainedNonExistentTerm)),
+    (
+      vec![v(), LinComb::from(Variable::CG { commitment: 0, index: N })],
+      Err(AcStatementError::ConstrainedNonExistentTerm),
+    ),
+    (
+      vec![v(), LinComb::from(Variable::CG { commitment: 1, index: 0 })],
+      Err(AcStatementError::ConstrainedNonExistentVectorCommitment),
+    ),
+    (vec![LinComb::from(Variable::V(1))], Err(AcStatementError::ConstrainedNonExistentCommitment)),
+    // The first error is the one returned
+    (
+      vec![
+        LinComb::from(Variable::CG { commitment: 1, index: 0 }),
+        LinComb::from(Variable::aL(N)),
+      ],
+      Err(AcStatementError::ConstrainedNonExistentVectorCommitment),
+    ),
+    (
+      vec![LinComb::from(Variable::aL(N)).term(F::ONE, Variable::CG { commitment: 1, index: 0 })],
+      Err(AcStatementError::ConstrainedNonExistentTerm),
+    ),
+    (vec![], Err(AcStatementError::DidNotConstrainCommitment)),
+    (
+      vec![LinComb::empty().term(F::ZERO, Variable::V(0))],
+      Err(AcStatementError::DidNotConstrainCommitment),
+    ),
+    (vec![v() + &v()], Err(AcStatementError::DidNotConstrainCommitment)),
+    // A bounds error takes precedence over the commitment not being constrained
+    (vec![LinComb::from(Variable::aL(N))], Err(AcStatementError::ConstrainedNonExistentTerm)),
+  ];
+
+  for (constraints, expected) in cases {
+    let new = ArithmeticCircuitStatement::new(
+      generators.reduce(N).unwrap(),
+      constraints.clone(),
+      commitments.clone(),
+    )
+    .map(|_| ());
+    assert_eq!(new, expected);
+
+    let z = F::random(&mut OsRng);
+    let mut accumulator = ConstraintAccumulator::<Ristretto>::new(N, 1, 1, z).unwrap();
+    let mut first_err = None;
+    for constraint in constraints.clone() {
+      if let Err(err) = accumulator.push(constraint) {
+        first_err.get_or_insert(err);
+      }
+    }
+    let accumulated = accumulator.clone().finish();
+    assert_eq!(accumulated.as_ref().map(|_| ()).map_err(|err| *err), expected);
+    if let Some(err) = first_err {
+      assert_eq!(Err(err), expected);
+      // The accumulator retains its error
+      assert_eq!(accumulator.push(v()), Err(err));
+      assert_eq!(accumulator.finish().map(|_| ()), Err(err));
+    } else if let Ok(accumulated) = accumulated {
+      let statement = ArithmeticCircuitStatement::new(
+        generators.reduce(N).unwrap(),
+        constraints,
+        commitments.clone(),
+      )
+      .unwrap();
+      assert_eq!(accumulated, statement.fold_constraints(z));
+    }
+  }
+
+  assert_eq!(
+    ConstraintAccumulator::<Ristretto>::new(N, usize::MAX >> 4, 0, F::ONE),
+    Err(AcStatementError::TooManyCommitments)
+  );
+}
